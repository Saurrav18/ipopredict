# ============================================================
#  IPOPredict secrets - copy this file to ".env" and fill in.
#  NEVER commit the real .env. Rotate any secret that leaks.
# ============================================================
GMAIL_USER=ipopredict@gmail.com
# 16-char Google App Password (NOT your normal Gmail password)
GMAIL_APP_PASS=
TELEGRAM_BOT_TOKEN=
# long random string; protects the owner-only /subscribers endpoint
ADMIN_TOKEN=
# long random string; signs unsubscribe links
APP_SECRET=
# optional: Google Gemini free-tier key for smarter Ask answers
GEMINI_API_KEY=
# set to 1 ONLY on your laptop for local testing (shows codes if email fails)
DEV_MODE=1
# --- public deploy only (leave blank for local) ---
SECURE_COOKIES=
APP_URL=

# SEBI-safe public build: 1 = facts+education only (no APPLY/SKIP, scores, ranges,
# tiers, accuracy claims, or forward alerts). 0 = full personal build.
COMPLIANCE_MODE=0
